# salin jadi .env lalu isi (jangan commit .env!)
LEMARI_DSN=postgresql://lemari:CHANGE_ME@postgres:5432/lemari
LEMARI_DOMAIN=lemari.dipo.sh
LEMARI_UPLOAD_DIR=/data/uploads
LEMARI_MEDIA_MAX_PX=1600
LEMARI_THUMB_MAX_PX=400

# AI auto-tag foto (OpenRouter)
LEMARI_OPENROUTER_KEY=
